# Gemini: se valorizzata, ha priorità assoluta
# Default automatici: text=gemini-3.1-flash-lite, audio=gemini-3.8-flash-lite-tts (Kore, wav)
GEMINI_API_KEY=

# OpenAI-compatible: usata solo se Gemini non è configurato
# Default integrati OpenRouter: text=mistralai/mistral-nemo, audio=hexgrad/kokoro-82m (if_sara, mp3)
# L'OpenAI Base URL (default https://openrouter.ai/api/v1) si configura nelle Impostazioni dell'app
OPENAI_API_KEY=

# Override opzionali dei modelli (non necessari se si usano i default o le Impostazioni nell'app)
TEXT_MODEL=
AUDIO_MODEL=
