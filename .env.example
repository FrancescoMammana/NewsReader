# Gemini: se valorizzata, ha priorità assoluta
# Default automatici: text=gemini-3.1-flash-lite, audio=gemini-3.8-flash-lite-tts (Kore, wav)
GEMINI_API_KEY=

# OpenAI-compatible: usata solo se Gemini non è configurato
# Default automatici OpenRouter: URL=https://openrouter.ai/api/v1, text=mistralai/mistral-nemo, audio=hexgrad/kokoro-82m (if_sara, mp3)
OPENAI_API_KEY=

# Override opzionali delle impostazioni in-app (non necessari se si usano i default o le Impostazioni nell'app)
OPENAI_BASE_URL=
TEXT_MODEL=
AUDIO_MODEL=
